<?xml version="1.0" ?>
<!--
  aws_warehouse.world — AWS RoboMaker small warehouse (Fuel / Harmonic).

  Textured shelves, clutter, walls, and floor from the OpenRobotics Fuel
  port of aws-robomaker-small-warehouse-world. Built for camera / visual
  SLAM — posters, labels, and shelf contents give RTAB-Map features.

  Fetch models first:
    bash src/rosnav_bot/scripts/download_fuel_worlds.sh aws_warehouse

  Launch:
    ros2 launch rosnav_bot slam_nav.launch.py world_name:=aws_warehouse \
      enable_camera:=true lidar_type:=3d slam_algo:=3d
-->
<sdf version='1.8'>
  <world name='aws_warehouse'>

    <physics name='4ms' type='ignored'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <light name='sun' type='directional'>
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.2 0.1 -0.9</direction>
      <diffuse>1.0 0.98 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </light>
    <light name='ceiling' type='point'>
      <pose>0 0 8.5 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>80</range><constant>0.3</constant><linear>0.01</linear></attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <include>
      <name>wall_b</name>
      <uri>model://aws_robomaker_warehouse_WallB_01</uri>
      <static>true</static>
    </include>
    <include>
      <name>ground_b</name>
      <uri>model://aws_robomaker_warehouse_GroundB_01</uri>
      <pose>0 0 -0.090092 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>lamp</name>
      <uri>model://aws_robomaker_warehouse_Lamp_01</uri>
      <pose>0 0 -4 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <name>shelf_f_001</name>
      <uri>model://aws_robomaker_warehouse_ShelfF_01</uri>
      <pose>-5.795143 -0.956635 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_e_001</name>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <pose>4.73156 0.57943 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_e_002</name>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <pose>4.73156 -4.827049 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_e_003</name>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <pose>4.73156 -8.6651 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_d_001</name>
      <uri>model://aws_robomaker_warehouse_ShelfD_01</uri>
      <pose>4.73156 -1.242668 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_d_002</name>
      <uri>model://aws_robomaker_warehouse_ShelfD_01</uri>
      <pose>4.73156 -3.038551 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_d_003</name>
      <uri>model://aws_robomaker_warehouse_ShelfD_01</uri>
      <pose>4.73156 -6.750542 0 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <name>bucket_020</name>
      <uri>model://aws_robomaker_warehouse_Bucket_01</uri>
      <pose>0.433449 9.631706 0 0 0 -1.563161</pose>
      <static>true</static>
    </include>
    <include>
      <name>bucket_021</name>
      <uri>model://aws_robomaker_warehouse_Bucket_01</uri>
      <pose>-1.8321 -6.3752 0 0 0 -1.563161</pose>
      <static>true</static>
    </include>
    <include>
      <name>bucket_022</name>
      <uri>model://aws_robomaker_warehouse_Bucket_01</uri>
      <pose>0.433449 8.59 0 0 0 -1.563161</pose>
      <static>true</static>
    </include>

    <include>
      <name>clutter_a_016</name>
      <uri>model://aws_robomaker_warehouse_ClutteringA_01</uri>
      <pose>5.708138 8.616844 -0.017477 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>clutter_a_017</name>
      <uri>model://aws_robomaker_warehouse_ClutteringA_01</uri>
      <pose>3.408638 8.616844 -0.017477 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>clutter_a_018</name>
      <uri>model://aws_robomaker_warehouse_ClutteringA_01</uri>
      <pose>-1.491287 5.222435 -0.017477 0 0 -1.583185</pose>
      <static>true</static>
    </include>

    <include>
      <name>clutter_c_027</name>
      <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
      <pose>3.324959 3.822449 -0.012064 0 0 1.563871</pose>
      <static>true</static>
    </include>
    <include>
      <name>clutter_c_028</name>
      <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
      <pose>5.54171 3.816475 -0.015663 0 0 -1.583191</pose>
      <static>true</static>
    </include>
    <include>
      <name>clutter_c_029</name>
      <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
      <pose>5.384239 6.137154 0 0 0 3.15</pose>
      <static>true</static>
    </include>
    <include>
      <name>clutter_c_030</name>
      <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
      <pose>3.236 6.137154 0 0 0 3.15</pose>
      <static>true</static>
    </include>
    <include>
      <name>clutter_c_031</name>
      <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
      <pose>-1.573677 2.301994 -0.015663 0 0 -3.133191</pose>
      <static>true</static>
    </include>
    <include>
      <name>clutter_c_032</name>
      <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
      <pose>-1.2196 9.407 -0.015663 0 0 1.563871</pose>
      <static>true</static>
    </include>
    <include>
      <name>clutter_d_005</name>
      <uri>model://aws_robomaker_warehouse_ClutteringD_01</uri>
      <pose>-1.634682 -7.811813 -0.319559 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>trash_002</name>
      <uri>model://aws_robomaker_warehouse_TrashCanC_01</uri>
      <pose>-1.592441 7.715420 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>pallet_jack</name>
      <uri>model://aws_robomaker_warehouse_PalletJackB_01</uri>
      <pose>-0.276098 -9.481944 0.023266 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Overview camera (generic placement — see hospital.world's
         world_monitor_cam for the hand-tuned original). -->
    <model name='world_monitor_cam'>
      <static>true</static>
      <pose>6.5 6.0 5.3 0 0.55 -2.356</pose>
      <link name='link'>
        <sensor name='monitor_camera' type='camera'>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>world_monitor/image_raw</topic>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>35.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
