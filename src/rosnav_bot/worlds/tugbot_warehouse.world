<?xml version="1.0" ?>
<!--
  tugbot_warehouse.world — OpenRobotics Warehouse + Mov.AI shelves.

  Textured warehouse from Fuel "Tugbot in Warehouse" (robot omitted so
  rosnav spawns its own). Shelves, pallets, and wall textures feed camera
  / RTAB-Map visual SLAM.

  Fetch models first:
    bash src/rosnav_bot/scripts/download_fuel_worlds.sh tugbot_warehouse

  Launch:
    ros2 launch rosnav_bot slam_nav.launch.py world_name:=tugbot_warehouse \
      enable_camera:=true lidar_type:=3d slam_algo:=3d
-->
<sdf version='1.8'>
  <world name='tugbot_warehouse'>

    <physics name='4ms' type='ignored'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <light name='sun' type='directional'>
      <pose>-5 -3 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>0 0 -1</direction>
    </light>
    <light name='aisle' type='point'>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.75 0.75 0.78 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>40</range><linear>0.02</linear></attenuation>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='c'>
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
        </collision>
        <visual name='v'>
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <name>warehouse</name>
      <uri>model://Warehouse</uri>
      <pose>0 0 -0.09 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>charging_station</name>
      <uri>model://Tugbot-charging-station</uri>
      <pose>14.7 -10.6 -0.04 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>cart1</name>
      <uri>model://cart_model_2</uri>
      <pose>-5.73 15 0.25 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <name>shelf_big_0</name>
      <uri>model://shelf_big</uri>
      <pose>-9.34177 -13.5598 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf</name>
      <uri>model://shelf</uri>
      <pose>-4.41528 -0.690987 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_0</name>
      <uri>model://shelf</uri>
      <pose>-4.41528 2.30697 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_1</name>
      <uri>model://shelf</uri>
      <pose>-4.41528 5.30708 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_2</name>
      <uri>model://shelf</uri>
      <pose>-4.41528 8.34352 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_3</name>
      <uri>model://shelf</uri>
      <pose>5.60144 8.34352 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_4</name>
      <uri>model://shelf</uri>
      <pose>5.60144 5.30708 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_5</name>
      <uri>model://shelf</uri>
      <pose>5.60144 -0.690987 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_6</name>
      <uri>model://shelf</uri>
      <pose>5.60144 2.30697 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>pallet_box_mobile</name>
      <uri>model://pallet_box_mobile</uri>
      <pose>4.4161 14.6952 0.01 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>pallet_box_mobile_0</name>
      <uri>model://pallet_box_mobile</uri>
      <pose>4.45415 13.6212 0.01 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>pallet_box_mobile_1</name>
      <uri>model://pallet_box_mobile</uri>
      <pose>4.4468 12.229 0.01 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>pallet_box</name>
      <uri>model://pallet_box_mobile</uri>
      <pose>-6.11913 13.7079 0.01 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_big_1</name>
      <uri>model://shelf_big</uri>
      <pose>13.9821 15.319 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_big_2</name>
      <uri>model://shelf_big</uri>
      <pose>6.19777 -12.9647 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_big_3</name>
      <uri>model://shelf_big</uri>
      <pose>0.594376 -12.9647 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_big_4</name>
      <uri>model://shelf_big</uri>
      <pose>-5.36284 -12.9647 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_7</name>
      <uri>model://shelf</uri>
      <pose>13.3818 -21.2416 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_8</name>
      <uri>model://shelf</uri>
      <pose>13.3818 -19.0028 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_9</name>
      <uri>model://shelf</uri>
      <pose>13.3818 -16.4478 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>shelf_10</name>
      <uri>model://shelf</uri>
      <pose>13.3818 -14.1028 0 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>pallet_box_0</name>
      <uri>model://pallet_box_mobile</uri>
      <pose>14.0222 -24.335 0.01 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Overview camera (generic placement — see hospital.world's
         world_monitor_cam for the hand-tuned original). -->
    <model name='world_monitor_cam'>
      <static>true</static>
      <pose>4.0 16.0 3.8 0 0.55 -2.356</pose>
      <link name='link'>
        <sensor name='monitor_camera' type='camera'>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>world_monitor/image_raw</topic>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>25.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
