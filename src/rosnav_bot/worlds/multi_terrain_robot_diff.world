<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="multi_terrain_robot_diff">
    <!--
      Multi-terrain / multi-drive benchmark world.

      Purpose:
        Compare diff, mecanum, and ackermann behavior in the same map.
        The world uses simple SDF primitives only, so it is stable in headless
        Gazebo and does not depend on Fuel assets or heightmap shaders.

      Suggested runs:
        ros2 launch rosnav_bot slam_nav.launch.py world_name:=multi_terrain_robot_diff explore:=true drive_type:=diff
        ros2 launch rosnav_bot slam_nav.launch.py world_name:=multi_terrain_robot_diff explore:=true drive_type:=mecanum
        ros2 launch rosnav_bot slam_nav.launch.py world_name:=multi_terrain_robot_diff explore:=true drive_type:=ackermann safety:=true controller:=mppi
    -->

    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.85 0.8 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.25 -0.9</direction>
    </light>

    <model name="base_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24 16 0.02</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>24 16 0.02</size></box></geometry>
          <material><ambient>0.62 0.65 0.66 1</ambient><diffuse>0.62 0.65 0.66 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Terrain labels are visual + physics hints today; a future terrain
         costmap layer can consume the same named regions. -->
    <model name="terrain_flat_concrete">
      <static>true</static>
      <pose>-7 0 0.021 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 13 0.01</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>6 13 0.01</size></box></geometry>
          <material><ambient>0.55 0.58 0.60 1</ambient><diffuse>0.55 0.58 0.60 1</diffuse></material></visual>
      </link>
    </model>

    <model name="terrain_gravel_rough">
      <static>true</static>
      <pose>0 4 0.024 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 2.2 0.016</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>8 2.2 0.016</size></box></geometry>
          <material><ambient>0.46 0.39 0.31 1</ambient><diffuse>0.46 0.39 0.31 1</diffuse></material></visual>
      </link>
    </model>

    <model name="terrain_low_friction_tile">
      <static>true</static>
      <pose>0 0 0.024 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 2.2 0.016</size></box></geometry>
          <surface><friction><ode><mu>0.25</mu><mu2>0.25</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>8 2.2 0.016</size></box></geometry>
          <material><ambient>0.31 0.47 0.70 1</ambient><diffuse>0.31 0.47 0.70 1</diffuse></material></visual>
      </link>
    </model>

    <model name="terrain_wide_asphalt">
      <static>true</static>
      <pose>0 -4 0.024 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 2.8 0.016</size></box></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>1.1</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>8 2.8 0.016</size></box></geometry>
          <material><ambient>0.33 0.34 0.36 1</ambient><diffuse>0.33 0.34 0.36 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Outer boundary. -->
    <model name="wall_north"><static>true</static><pose>0 8 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>24 0.18 1</size></box></geometry></collision><visual name="v"><geometry><box><size>24 0.18 1</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -8 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>24 0.18 1</size></box></geometry></collision><visual name="v"><geometry><box><size>24 0.18 1</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-12 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.18 16 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.18 16 1</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>12 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.18 16 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.18 16 1</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual></link></model>

    <!-- Lane separators with west/east hub openings. -->
    <model name="sep_upper_left"><static>true</static><pose>-1.2 2.1 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>12.5 0.16 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>12.5 0.16 0.7</size></box></geometry><material><ambient>0.18 0.23 0.26 1</ambient><diffuse>0.18 0.23 0.26 1</diffuse></material></visual></link></model>
    <model name="sep_upper_right"><static>true</static><pose>9.0 2.1 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.5 0.16 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>2.5 0.16 0.7</size></box></geometry><material><ambient>0.18 0.23 0.26 1</ambient><diffuse>0.18 0.23 0.26 1</diffuse></material></visual></link></model>
    <model name="sep_lower_left"><static>true</static><pose>-1.2 -2.1 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>12.5 0.16 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>12.5 0.16 0.7</size></box></geometry><material><ambient>0.18 0.23 0.26 1</ambient><diffuse>0.18 0.23 0.26 1</diffuse></material></visual></link></model>
    <model name="sep_lower_right"><static>true</static><pose>9.0 -2.1 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.5 0.16 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>2.5 0.16 0.7</size></box></geometry><material><ambient>0.18 0.23 0.26 1</ambient><diffuse>0.18 0.23 0.26 1</diffuse></material></visual></link></model>

    <!-- Upper lane: tight chicane. Diff can spin in place; ackermann should struggle. -->
    <model name="diff_chicane_gate_a"><static>true</static><pose>-1.8 4.75 0.4 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.28 1.5 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>0.28 1.5 0.8</size></box></geometry><material><ambient>0.65 0.22 0.20 1</ambient><diffuse>0.65 0.22 0.20 1</diffuse></material></visual></link></model>
    <model name="diff_chicane_gate_b"><static>true</static><pose>0.0 3.25 0.4 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.28 1.5 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>0.28 1.5 0.8</size></box></geometry><material><ambient>0.65 0.22 0.20 1</ambient><diffuse>0.65 0.22 0.20 1</diffuse></material></visual></link></model>
    <model name="diff_chicane_gate_c"><static>true</static><pose>1.8 4.75 0.4 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.28 1.5 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>0.28 1.5 0.8</size></box></geometry><material><ambient>0.65 0.22 0.20 1</ambient><diffuse>0.65 0.22 0.20 1</diffuse></material></visual></link></model>

    <!-- Middle lane: lateral offset gates. Mecanum can correct sideways with less turning. -->
    <model name="mecanum_offset_gate_north"><static>true</static><pose>-1.1 0.72 0.4 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>3.2 0.26 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>3.2 0.26 0.8</size></box></geometry><material><ambient>0.20 0.45 0.66 1</ambient><diffuse>0.20 0.45 0.66 1</diffuse></material></visual></link></model>
    <model name="mecanum_offset_gate_south"><static>true</static><pose>1.4 -0.72 0.4 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>3.2 0.26 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>3.2 0.26 0.8</size></box></geometry><material><ambient>0.20 0.45 0.66 1</ambient><diffuse>0.20 0.45 0.66 1</diffuse></material></visual></link></model>

    <!-- Lower lane: wide slalom sized for Ackermann's turning radius. -->
    <model name="ackermann_wide_bollard_a"><static>true</static><pose>-2.5 -4.0 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.45</radius><length>0.7</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.45</radius><length>0.7</length></cylinder></geometry><material><ambient>0.82 0.58 0.16 1</ambient><diffuse>0.82 0.58 0.16 1</diffuse></material></visual></link></model>
    <model name="ackermann_wide_bollard_b"><static>true</static><pose>0.5 -5.0 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.45</radius><length>0.7</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.45</radius><length>0.7</length></cylinder></geometry><material><ambient>0.82 0.58 0.16 1</ambient><diffuse>0.82 0.58 0.16 1</diffuse></material></visual></link></model>
    <model name="ackermann_wide_bollard_c"><static>true</static><pose>3.5 -3.2 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.45</radius><length>0.7</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.45</radius><length>0.7</length></cylinder></geometry><material><ambient>0.82 0.58 0.16 1</ambient><diffuse>0.82 0.58 0.16 1</diffuse></material></visual></link></model>

    <!-- Small roughness samples visible to lidar/depth but low enough for most wheeled bases. -->
    <model name="rough_marker_bumps">
      <static>true</static>
      <link name="bump_a"><pose>-2.7 4.0 0.055 0 0 0</pose><collision name="c"><geometry><box><size>0.35 0.35 0.07</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 0.35 0.07</size></box></geometry><material><ambient>0.36 0.28 0.22 1</ambient><diffuse>0.36 0.28 0.22 1</diffuse></material></visual></link>
      <link name="bump_b"><pose>-0.8 4.25 0.045 0 0 0</pose><collision name="c"><geometry><box><size>0.28 0.28 0.05</size></box></geometry></collision><visual name="v"><geometry><box><size>0.28 0.28 0.05</size></box></geometry><material><ambient>0.36 0.28 0.22 1</ambient><diffuse>0.36 0.28 0.22 1</diffuse></material></visual></link>
      <link name="bump_c"><pose>1.1 3.75 0.05 0 0 0</pose><collision name="c"><geometry><box><size>0.3 0.3 0.06</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 0.3 0.06</size></box></geometry><material><ambient>0.36 0.28 0.22 1</ambient><diffuse>0.36 0.28 0.22 1</diffuse></material></visual></link>
      <link name="bump_d"><pose>2.8 4.2 0.045 0 0 0</pose><collision name="c"><geometry><box><size>0.25 0.25 0.05</size></box></geometry></collision><visual name="v"><geometry><box><size>0.25 0.25 0.05</size></box></geometry><material><ambient>0.36 0.28 0.22 1</ambient><diffuse>0.36 0.28 0.22 1</diffuse></material></visual></link>
    </model>

    <!-- Landmarks at lane exits help SLAM disambiguate the repeated lanes. -->
    <model name="exit_marker_diff_lane"><static>true</static><pose>7.5 4.0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.35 0.35 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 0.35 1.0</size></box></geometry><material><ambient>0.85 0.18 0.18 1</ambient><diffuse>0.85 0.18 0.18 1</diffuse></material></visual></link></model>
    <model name="exit_marker_mecanum_lane"><static>true</static><pose>7.5 0.0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.35 0.35 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 0.35 1.0</size></box></geometry><material><ambient>0.18 0.45 0.85 1</ambient><diffuse>0.18 0.45 0.85 1</diffuse></material></visual></link></model>
    <model name="exit_marker_ackermann_lane"><static>true</static><pose>7.5 -4.0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.35 0.35 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 0.35 1.0</size></box></geometry><material><ambient>0.86 0.65 0.16 1</ambient><diffuse>0.86 0.65 0.16 1</diffuse></material></visual></link></model>
  </world>
</sdf>
