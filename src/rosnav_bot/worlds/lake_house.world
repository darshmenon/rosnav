<?xml version="1.0" ?>
<!--
  lake_house.world — OpenRobotics Lake House (PBR) + furniture.

  Photorealistic indoor house from the Gazebo Harmonic demo world. Walls,
  floors, and furniture have albedo textures so RGB / RGB-D cameras give
  RTAB-Map visual features (plain primitive worlds do not).

  Interior floors: ground ~z=6.90 m, upstairs ~z=9.46 m.
  Fetch models first:
    bash src/rosnav_bot/scripts/download_fuel_worlds.sh lake_house

  Launch:
    ros2 launch rosnav_bot slam_nav.launch.py world_name:=lake_house \
      enable_camera:=true lidar_type:=3d slam_algo:=3d
-->
<sdf version='1.8'>
  <world name='lake_house'>

    <physics name='4ms' type='ignored'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>

    <light name='sun' type='directional'>
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.1 0.1 -0.95</direction>
      <diffuse>1.0 0.99 0.97 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </light>
    <light name='living' type='point'>
      <pose>0.73 0.09 8.77 0 0 0</pose>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation><range>20</range><linear>0.04</linear></attenuation>
    </light>
    <light name='dining' type='point'>
      <pose>3.48 -4.28 8.87 0 0 0</pose>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation><range>20</range><linear>0.04</linear></attenuation>
    </light>
    <light name='upstairs' type='point'>
      <pose>0.13 0.46 11.60 0 0 0</pose>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation><range>20</range><linear>0.04</linear></attenuation>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='c'>
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name='v'>
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.45 0.55 0.35 1</ambient><diffuse>0.45 0.55 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <name>Lake House</name>
      <uri>model://Lake House</uri>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <name>Armchair_01</name>
      <uri>model://Armchair</uri>
      <pose>-0.24 -0.13 6.90 0 0 -0.77</pose>
      <static>true</static>
    </include>
    <include>
      <name>Armchair_02</name>
      <uri>model://Armchair</uri>
      <pose>-0.12 -1.44 6.90 0 0 -1.75</pose>
      <static>true</static>
    </include>
    <include>
      <name>Dining Table</name>
      <uri>model://Dining Table</uri>
      <pose>3.45 -3.88 6.90 0 0 -1.57</pose>
      <static>true</static>
    </include>
    <include>
      <name>Dining Chair 01</name>
      <uri>model://Dining Chair</uri>
      <pose>2.9 -3.34 6.90 0 0 -0.03</pose>
      <static>true</static>
    </include>
    <include>
      <name>Dining Chair 02</name>
      <uri>model://Dining Chair</uri>
      <pose>3.87 -3.19 6.90 0 0 -0.32</pose>
      <static>true</static>
    </include>
    <include>
      <name>Dining Chair 03</name>
      <uri>model://Dining Chair</uri>
      <pose>3.81 -4.43 6.90 0 0 -2.69</pose>
      <static>true</static>
    </include>
    <include>
      <name>Dining Chair 04</name>
      <uri>model://Dining Chair</uri>
      <pose>2.88 -4.60 6.90 0 0 2.87</pose>
      <static>true</static>
    </include>
    <include>
      <name>Fridge</name>
      <uri>model://Refrigerator</uri>
      <pose>1.75 -3.89 6.90 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>Oven</name>
      <uri>model://Oven</uri>
      <pose>4.34 -6.36 6.83 0 0 1.57</pose>
      <static>true</static>
    </include>
    <include>
      <name>Piano</name>
      <uri>model://Piano</uri>
      <pose>2.98 0.85 6.91 0 0 -2.37</pose>
      <static>true</static>
    </include>
    <include>
      <name>Pendulum_sculpture</name>
      <uri>model://Pendulum Sculpture</uri>
      <pose>3.43 -3.82 7.64 0 0 1.57</pose>
      <static>true</static>
    </include>
    <include>
      <name>Bed</name>
      <uri>model://Bed</uri>
      <pose>0.14 -1.62 9.46 0 0 3.14</pose>
      <static>true</static>
    </include>
    <include>
      <name>Bathtub</name>
      <uri>model://Bathtub</uri>
      <pose>5.46 -1.63 9.46 0 0 -1.57</pose>
      <static>true</static>
    </include>
    <include>
      <name>Toilet</name>
      <uri>model://Standard Toilet</uri>
      <pose>2.75 -1.79 9.46 0 0 1.57</pose>
      <static>true</static>
    </include>
    <include>
      <name>Vanity</name>
      <uri>model://Vanity</uri>
      <pose>3.03 0.49 9.46 0 0 1.57</pose>
      <static>true</static>
    </include>
    <include>
      <name>Desk</name>
      <uri>model://Office Desk</uri>
      <pose>-0.39 2.31 9.48 0 0 -1.57</pose>
      <static>true</static>
    </include>
    <include>
      <name>Office Chair</name>
      <uri>model://Office Chair</uri>
      <pose>-0.74 1.45 9.48 0 0 -0.81</pose>
      <static>true</static>
    </include>

    <!-- Overview camera (generic placement — see hospital.world's
         world_monitor_cam for the hand-tuned original). -->
    <model name='world_monitor_cam'>
      <static>true</static>
      <pose>5.2 4.8 10.7 0 0.55 -2.356</pose>
      <link name='link'>
        <sensor name='monitor_camera' type='camera'>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>world_monitor/image_raw</topic>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>25.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
