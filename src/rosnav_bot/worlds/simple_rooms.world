<?xml version="1.0" ?>
<!--
  simple_rooms.world — exploration-friendly multi-room layout.

  Purpose:
    A simpler alternative to house.world for frontier exploration tests. It
    keeps the useful challenge of multiple rooms and doorways, but removes
    furniture clutter, stairs/loft geometry, and narrow passages that can make
    Nav2/SLAM debugging ambiguous.

  Clearance rules:
    - Door openings are 2.0m wide.
    - Main hallway is 3.0m wide.
    - No free-standing obstacles in the robot path.
    - Spawn is centered in a clear room.

  Launch:
    ros2 launch rosnav_bot slam_nav.launch.py world_name:=simple_rooms explore:=true
-->
<sdf version='1.8'>
  <world name='simple_rooms'>

    <physics name='4ms' type='ignored'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <light name='sun' type='directional'>
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.0</intensity>
      <direction>-0.35 0.15 -0.92</direction>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
    </light>

    <light name='ceiling_center' type='point'>
      <pose>0 0 3.2 0 0 0</pose>
      <diffuse>0.9 0.9 0.86 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>18</range>
        <linear>0.08</linear>
      </attenuation>
    </light>

    <!-- Ground plane -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.68 0.68 0.68 1</ambient>
            <diffuse>0.68 0.68 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Floor pad: 18m x 14m interior footprint. -->
    <model name='floor'>
      <static>true</static>
      <pose>0 0 0.003 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>18.0 14.0 0.004</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>18.0 14.0 0.004</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.54 1</ambient>
            <diffuse>0.55 0.58 0.54 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer walls, interior bounds x=[-9,9], y=[-7,7]. -->
    <model name='wall_north'><static>true</static><pose>0 7.1 1.25 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>18.4 0.2 2.5</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>18.4 0.2 2.5</size></box></geometry>
        <material><ambient>0.46 0.50 0.58 1</ambient><diffuse>0.46 0.50 0.58 1</diffuse></material></visual>
    </link></model>

    <model name='wall_south'><static>true</static><pose>0 -7.1 1.25 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>18.4 0.2 2.5</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>18.4 0.2 2.5</size></box></geometry>
        <material><ambient>0.46 0.50 0.58 1</ambient><diffuse>0.46 0.50 0.58 1</diffuse></material></visual>
    </link></model>

    <model name='wall_east'><static>true</static><pose>9.1 0 1.25 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>0.2 14.4 2.5</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>0.2 14.4 2.5</size></box></geometry>
        <material><ambient>0.46 0.50 0.58 1</ambient><diffuse>0.46 0.50 0.58 1</diffuse></material></visual>
    </link></model>

    <model name='wall_west'><static>true</static><pose>-9.1 0 1.25 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>0.2 14.4 2.5</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>0.2 14.4 2.5</size></box></geometry>
        <material><ambient>0.46 0.50 0.58 1</ambient><diffuse>0.46 0.50 0.58 1</diffuse></material></visual>
    </link></model>

    <!-- Main vertical partitions: four rooms around a 3m-wide central hall. -->
    <model name='partition_west_north'><static>true</static><pose>-3.1 5.0 1.25 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>0.2 4.0 2.5</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>0.2 4.0 2.5</size></box></geometry>
        <material><ambient>0.58 0.58 0.54 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material></visual>
    </link></model>

    <model name='partition_west_south'><static>true</static><pose>-3.1 -5.0 1.25 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>0.2 4.0 2.5</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>0.2 4.0 2.5</size></box></geometry>
        <material><ambient>0.58 0.58 0.54 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material></visual>
    </link></model>

    <model name='partition_east_north'><static>true</static><pose>3.1 5.0 1.25 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>0.2 4.0 2.5</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>0.2 4.0 2.5</size></box></geometry>
        <material><ambient>0.58 0.58 0.54 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material></visual>
    </link></model>

    <model name='partition_east_south'><static>true</static><pose>3.1 -5.0 1.25 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>0.2 4.0 2.5</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>0.2 4.0 2.5</size></box></geometry>
        <material><ambient>0.58 0.58 0.54 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material></visual>
    </link></model>

    <!-- Horizontal partitions with wide doorway gaps into the central hall. -->
    <model name='partition_north_west'><static>true</static><pose>-6.0 1.6 1.25 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>6.0 0.2 2.5</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>6.0 0.2 2.5</size></box></geometry>
        <material><ambient>0.58 0.58 0.54 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material></visual>
    </link></model>

    <model name='partition_north_east'><static>true</static><pose>6.0 1.6 1.25 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>6.0 0.2 2.5</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>6.0 0.2 2.5</size></box></geometry>
        <material><ambient>0.58 0.58 0.54 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material></visual>
    </link></model>

    <model name='partition_south_west'><static>true</static><pose>-6.0 -1.6 1.25 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>6.0 0.2 2.5</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>6.0 0.2 2.5</size></box></geometry>
        <material><ambient>0.58 0.58 0.54 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material></visual>
    </link></model>

    <model name='partition_south_east'><static>true</static><pose>6.0 -1.6 1.25 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>6.0 0.2 2.5</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>6.0 0.2 2.5</size></box></geometry>
        <material><ambient>0.58 0.58 0.54 1</ambient><diffuse>0.58 0.58 0.54 1</diffuse></material></visual>
    </link></model>

    <!-- Low landmark blocks against room centers. They are not in doorways
         and leave >2m turning clearance, but add enough structure for SLAM. -->
    <model name='landmark_nw'><static>true</static><pose>-6.3 4.5 0.3 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
        <material><ambient>0.65 0.40 0.35 1</ambient><diffuse>0.65 0.40 0.35 1</diffuse></material></visual>
    </link></model>

    <model name='landmark_ne'><static>true</static><pose>6.3 4.5 0.3 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
        <material><ambient>0.35 0.50 0.65 1</ambient><diffuse>0.35 0.50 0.65 1</diffuse></material></visual>
    </link></model>

    <model name='landmark_sw'><static>true</static><pose>-6.3 -4.5 0.3 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
        <material><ambient>0.45 0.62 0.42 1</ambient><diffuse>0.45 0.62 0.42 1</diffuse></material></visual>
    </link></model>

    <model name='landmark_se'><static>true</static><pose>6.3 -4.5 0.3 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
        <material><ambient>0.65 0.58 0.35 1</ambient><diffuse>0.65 0.58 0.35 1</diffuse></material></visual>
    </link></model>

    <!-- Overview camera -->
    <model name='world_monitor_cam'>
      <static>true</static>
      <pose>0 0 13 0 1.5708 0</pose>
      <link name='link'>
        <sensor name='monitor_camera' type='camera'>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>world_monitor/image_raw</topic>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>30.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
