    <!-- ── Detectable objects (Gazebo Fuel, OpenRobotics collection) ──────
         For yolo_detector.py testing — these map to COCO classes (person,
         chair, fire hydrant, suitcase) so YOLOv8 actually finds something,
         unlike the primitive shelves/pallets above. Placed in open staging-
         zone floor and by the loading dock, clear of the robot spawn path
         and shelf rows. Downloaded + cached by gz sim on first launch. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>person_1</name>
      <pose>-7 5 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking person</uri>
      <name>person_2</name>
      <pose>-7 -5 0 0 0 1.5708</pose>
    </include>
    <include>
