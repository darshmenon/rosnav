<?xml version="1.0" ?>
<!--
  warehouse.world — Large warehouse environment for multi-robot fleet testing.
  Structure (walls/shelves/pillars/pallets/catwalk/forklift) is all primitives:
  loads instantly, no downloads needed for those. A handful of real-world
  objects (person, chair, fire hydrant, suitcase — for yolo_detector.py /
  enable_yolo:=true testing) are pulled from Gazebo Fuel via <include><uri>,
  which gz sim downloads once and caches locally (~/.gz/fuel) — needs internet
  on first launch only.

  Layout (29 m × 20 m):
    Staging / spawn zone  :  x = -11 to -4,  y = -8 to 8  (western open area)
    Separator wall        :  x = -3            (with 2 m gap at y = 0 for passage)
    Storage zone          :  x = -2  to 11,   y = -8 to 8
      - 5 double shelf-rows (each pair separated by 1 m pick-aisle)
      - 3 m drive-aisles between row-pairs
      - Row 1 (y=8/7): two-tier racking (upper shelf board + posts) — tallest, 2.2 m
      - Row 2 (y=4.5/3.5): low waist-height shelving, 1.1 m — deliberately
        shorter so a 3D lidar scan can't alias it with the other rows
      - Row 3 (y=1.0/0.0): middle segment removed on both sides — opens a
        north-south cross-aisle at x=3.5, giving frontier exploration and
        RTAB-Map loop closure an actual loop path instead of a dead-end grid
      - Row 4 (y=-3/-4): standard 1.6 m, 3 segments (unchanged baseline)
      - Row 5 (y=-7/-8): tall single-tier, 1.8 m
      - Support pillars at x = 0, 4, 8   along y = ±3, each with 2 safety
        bollards at the base
    East bay (x = 12 to 17, y = -10 to 10) — through a 2.4 m doorway in the
    former east wall:
      - NE corner: enclosed break room (desk, chair, table)
      - SE area: raised loading-dock platform (0.6 m, forklift/pallet-jack
        access only — not navigable, a real 3D obstacle for the 2D costmap)
      - Center corridor: overhead catwalk/mezzanine (poles + railed deck at
        z≈2.4 m) with a parked forklift and pallet jack underneath, plus a
        ceiling-height pipe run along the far wall

  Robot spawn area:  x = -9 to -5,  y = -6 to 6
  Loading dock (staging pallets before the doorway):  x = 10 to 11,  y = -4 to 4
  Raised dock platform (east bay):  x = 12.3 to 16.8,  y = -9.7 to -3

  Launch:
    ros2 launch rosnav_bot multi_robot.launch.py world:=warehouse
-->
<sdf version='1.8'>
  <world name='warehouse'>

    <physics name='4ms' type='ignored'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>

    <!-- Overhead lighting -->
    <light name='sun' type='directional'>
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.2 0.1 -0.9</direction>
      <diffuse>1.0 0.98 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </light>
    <light name='light_west' type='point'>
      <pose>-7 0 4 0 0 0</pose>
      <diffuse>0.8 0.8 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>15</range><linear>0.05</linear></attenuation>
    </light>
    <light name='light_east' type='point'>
      <pose>5 0 4 0 0 0</pose>
      <diffuse>0.8 0.8 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>15</range><linear>0.05</linear></attenuation>
    </light>
    <light name='light_bay_n' type='point'>
      <pose>14.5 4 4 0 0 0</pose>
      <diffuse>0.8 0.8 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>15</range><linear>0.05</linear></attenuation>
    </light>
    <light name='light_bay_s' type='point'>
      <pose>14.5 -6 4 0 0 0</pose>
      <diffuse>0.8 0.8 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>15</range><linear>0.05</linear></attenuation>
    </light>

    <!-- ── Ground plane ──────────────────────────────────────────────────── -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='c'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='v'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Floor zone markers (flat coloured pads, h=0.005 m) ───────────── -->
    <!-- Staging zone: light blue -->
    <model name='zone_staging'>
      <static>true</static><pose>-7.5 0 0.003 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>7 16 0.005</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>7 16 0.005</size></box></geometry>
          <material><ambient>0.55 0.75 0.95 0.6</ambient><diffuse>0.55 0.75 0.95 0.6</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Storage zone: light warm grey -->
    <model name='zone_storage'>
      <static>true</static><pose>4.5 0 0.003 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>13 16 0.005</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>13 16 0.005</size></box></geometry>
          <material><ambient>0.88 0.85 0.80 0.6</ambient><diffuse>0.88 0.85 0.80 0.6</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Loading dock: yellow -->
    <model name='zone_dock'>
      <static>true</static><pose>10.5 0 0.003 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>1.5 8 0.005</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>1.5 8 0.005</size></box></geometry>
          <material><ambient>0.95 0.85 0.1 0.7</ambient><diffuse>0.95 0.85 0.1 0.7</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- East bay floor: cool industrial grey -->
    <model name='zone_bay'>
      <static>true</static><pose>14.5 0 0.003 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>5 20 0.005</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>5 20 0.005</size></box></geometry>
          <material><ambient>0.65 0.68 0.70 0.6</ambient><diffuse>0.65 0.68 0.70 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Outer walls (24 m × 20 m, 3 m tall) ─────────────────────────── -->
    <!-- North wall (extended east to cover the new east bay) -->
    <model name='wall_north'>
      <static>true</static><pose>2.5 10 1.5 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>29.4 0.2 3</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>29.4 0.2 3</size></box></geometry>
          <material><ambient>0.70 0.62 0.52 1</ambient><diffuse>0.70 0.62 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- South wall (extended east to cover the new east bay) -->
    <model name='wall_south'>
      <static>true</static><pose>2.5 -10 1.5 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>29.4 0.2 3</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>29.4 0.2 3</size></box></geometry>
          <material><ambient>0.70 0.62 0.52 1</ambient><diffuse>0.70 0.62 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Former east wall (x=12) is now a doorway into the east bay: two
         segments with a 2.4 m gap at y=-1.2..1.2 -->
    <model name='wall_east_n'>
      <static>true</static><pose>12 5.6 1.5 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.2 8.8 3</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.2 8.8 3</size></box></geometry>
          <material><ambient>0.70 0.62 0.52 1</ambient><diffuse>0.70 0.62 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='wall_east_s'>
      <static>true</static><pose>12 -5.6 1.5 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.2 8.8 3</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.2 8.8 3</size></box></geometry>
          <material><ambient>0.70 0.62 0.52 1</ambient><diffuse>0.70 0.62 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Far east wall (outer boundary of the east bay) -->
    <model name='wall_east_far'>
      <static>true</static><pose>17 0 1.5 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.2 20 3</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.2 20 3</size></box></geometry>
          <material><ambient>0.70 0.62 0.52 1</ambient><diffuse>0.70 0.62 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- West wall -->
    <model name='wall_west'>
      <static>true</static><pose>-12 0 1.5 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.2 20 3</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.2 20 3</size></box></geometry>
          <material><ambient>0.70 0.62 0.52 1</ambient><diffuse>0.70 0.62 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Interior separator wall (x = -3, gap at y=0 ±1.2 m) ─────────── -->
    <!-- North segment: y = 2 to 10 -->
    <model name='sep_north'>
      <static>true</static><pose>-3 6 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.2 8 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.2 8 2.5</size></box></geometry>
          <material><ambient>0.60 0.60 0.60 1</ambient><diffuse>0.60 0.60 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- South segment: y = -2 to -10 -->
    <model name='sep_south'>
      <static>true</static><pose>-3 -6 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.2 8 2.5</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.2 8 2.5</size></box></geometry>
          <material><ambient>0.60 0.60 0.60 1</ambient><diffuse>0.60 0.60 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Support pillars (x=0,4,8 at y=±6) ───────────────────────────── -->
    <model name='pillar_A1'><static>true</static><pose>0  6 1.5 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name='pillar_A2'><static>true</static><pose>0 -6 1.5 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name='pillar_B1'><static>true</static><pose>4  6 1.5 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name='pillar_B2'><static>true</static><pose>4 -6 1.5 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name='pillar_C1'><static>true</static><pose>8  6 1.5 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <model name='pillar_C2'><static>true</static><pose>8 -6 1.5 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.15</radius><length>3</length></cylinder></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>

    <!-- ── Shelf rows ────────────────────────────────────────────────────── -->
    <!--
      4 double shelf-rows, each pair:
        front shelf  +  1 m pick-aisle  +  back shelf
      3 m drive-aisle between pairs.

      Row pair 1:  front y=+8.0,  back y=+7.0   (drive-aisle → y=+5.5)
      Row pair 2:  front y=+4.5,  back y=+3.5   (drive-aisle → y=+2.0)
      Row pair 3:  front y=+1.0,  back y=+0.0   (drive-aisle → y=-1.5)
      Row pair 4:  front y=-3.0,  back y=-4.0   (drive-aisle → y=-5.5)
      Row pair 5:  front y=-7.0,  back y=-8.0

      Each shelf: 3 segments × 3 m (0.5 m gap between) at x=0, 3.5, 7
      Shelf dimensions: 2.8 m long × 0.5 m deep × 1.6 m tall
    -->

    <!-- Shelf material macros (brown tones per row for visual variety) -->

    <!-- ROW PAIR 1 — y=8.0 / 7.0 -->
    <!-- front y=8.0 -->
    <model name='sh_1f_1'><static>true</static><pose>0   8.0 0.8 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>2.8 0.5 1.6</size></box></geometry></collision><visual name='v'><geometry><box><size>2.8 0.5 1.6</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual></link></model>
    <model name='sh_1f_2'><static>true</static><pose>3.5 8.0 0.8 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>2.8 0.5 1.6</size></box></geometry></collision><visual name='v'><geometry><box><size>2.8 0.5 1.6</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual></link></model>
    <model name='sh_1f_3'><static>true</static><pose>7.0 8.0 0.8 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>2.8 0.5 1.6</size></box></geometry></collision><visual name='v'><geometry><box><size>2.8 0.5 1.6</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual></link></model>
    <!-- back y=7.0 -->
    <model name='sh_1b_1'><static>true</static><pose>0   7.0 0.8 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>2.8 0.5 1.6</size></box></geometry></collision><visual name='v'><geometry><box><size>2.8 0.5 1.6</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual></link></model>
    <model name='sh_1b_2'><static>true</static><pose>3.5 7.0 0.8 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>2.8 0.5 1.6</size></box></geometry></collision><visual name='v'><geometry><box><size>2.8 0.5 1.6</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual></link></model>
    <model name='sh_1b_3'><static>true</static><pose>7.0 7.0 0.8 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>2.8 0.5 1.6</size></box></geometry></collision><visual name='v'><geometry><box><size>2.8 0.5 1.6</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual></link></model>

    <!-- Row pair 1 upper tier: a second shelf board at z=2.0 on posts, on
         top of each lower segment above — two-tier racking gives the 3D
         lidar/RTAB-Map a distinct height profile for this row that the
         other (single-tier) rows don't share. -->
    <model name='sh_1f_1_post_a'><static>true</static><pose>-1.2 7.85 1.1 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.03</radius><length>2.2</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.03</radius><length>2.2</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name='sh_1f_1_post_b'><static>true</static><pose>1.2 7.85 1.1 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.03</radius><length>2.2</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.03</radius><length>2.2</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name='sh_1f_1_upper'><static>true</static><pose>0 8.0 2.0 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>2.8 0.5 0.08</size></box></geometry></collision><visual name='v'><geometry><box><size>2.8 0.5 0.08</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual></link></model>
    <model name='sh_1f_2_post_a'><static>true</static><pose>2.3 7.85 1.1 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.03</radius><length>2.2</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.03</radius><length>2.2</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name='sh_1f_2_post_b'><static>true</static><pose>4.7 7.85 1.1 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.03</radius><length>2.2</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.03</radius><length>2.2</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name='sh_1f_2_upper'><static>true</static><pose>3.5 8.0 2.0 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>2.8 0.5 0.08</size></box></geometry></collision><visual name='v'><geometry><box><size>2.8 0.5 0.08</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual></link></model>
    <model name='sh_1f_3_post_a'><static>true</static><pose>5.8 7.85 1.1 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.03</radius><length>2.2</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.03</radius><length>2.2</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name='sh_1f_3_post_b'><static>true</static><pose>8.2 7.85 1.1 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.03</radius><length>2.2</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.03</radius><length>2.2</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name='sh_1f_3_upper'><static>true</static><pose>7.0 8.0 2.0 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>2.8 0.5 0.08</size></box></geometry></collision><visual name='v'><geometry><box><size>2.8 0.5 0.08</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual></link></model>
    <model name='sh_1b_1_upper'><static>true</static><pose>0   7.0 2.0 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>2.8 0.5 0.08</size></box></geometry></collision><visual name='v'><geometry><box><size>2.8 0.5 0.08</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual></link></model>
    <model name='sh_1b_2_upper'><static>true</static><pose>3.5 7.0 2.0 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>2.8 0.5 0.08</size></box></geometry></collision><visual name='v'><geometry><box><size>2.8 0.5 0.08</size></box></geometry><material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material></visual></link></model>
