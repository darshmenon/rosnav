      <link name='link'>
        <collision name='c'><geometry><box><size>4.5 0.15 0.01</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>4.5 0.15 0.01</size></box></geometry>
          <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Overhead catwalk/mezzanine over the bay corridor (z≈2.4 m): 4 poles
         + a railed deck. Decorative — floor beneath stays clear for nav. -->
    <model name='catwalk_pole_1'><static>true</static><pose>12.6 -2.7 1.2 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.05</radius><length>2.4</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.05</radius><length>2.4</length></cylinder></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual></link></model>
    <model name='catwalk_pole_2'><static>true</static><pose>12.6 4.7 1.2 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.05</radius><length>2.4</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.05</radius><length>2.4</length></cylinder></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual></link></model>
    <model name='catwalk_pole_3'><static>true</static><pose>16.5 -2.7 1.2 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.05</radius><length>2.4</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.05</radius><length>2.4</length></cylinder></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual></link></model>
    <model name='catwalk_pole_4'><static>true</static><pose>16.5 4.7 1.2 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.05</radius><length>2.4</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.05</radius><length>2.4</length></cylinder></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual></link></model>
    <model name='catwalk_deck'><static>true</static><pose>14.55 1.0 2.425 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>3.9 7.4 0.05</size></box></geometry></collision><visual name='v'><geometry><box><size>3.9 7.4 0.05</size></box></geometry><material><ambient>0.4 0.4 0.42 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material></visual></link></model>
    <model name='catwalk_rail_w'><static>true</static><pose>12.75 1.0 2.6 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>0.05 7.4 0.3</size></box></geometry></collision><visual name='v'><geometry><box><size>0.05 7.4 0.3</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual></link></model>
    <model name='catwalk_rail_e'><static>true</static><pose>16.35 1.0 2.6 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>0.05 7.4 0.3</size></box></geometry></collision><visual name='v'><geometry><box><size>0.05 7.4 0.3</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual></link></model>

    <!-- Ceiling-height pipe run along the far wall -->
    <model name='pipe_run'><static>true</static><pose>16.8 0 2.0 0 0 0</pose><link name='link'><collision name='c'><geometry><box><size>0.15 20 0.15</size></box></geometry></collision><visual name='v'><geometry><box><size>0.15 20 0.15</size></box></geometry><material><ambient>0.5 0.15 0.1 1</ambient><diffuse>0.5 0.15 0.1 1</diffuse></material></visual></link></model>

    <!-- Parked forklift (primitives) under the catwalk -->
    <model name='forklift_body'><static>true</static><pose>13.4 2.2 0.5 0 0 -0.4</pose><link name='link'><collision name='c'><geometry><box><size>1.2 0.9 1.0</size></box></geometry></collision><visual name='v'><geometry><box><size>1.2 0.9 1.0</size></box></geometry><material><ambient>0.9 0.55 0.1 1</ambient><diffuse>0.9 0.55 0.1 1</diffuse></material></visual></link></model>
    <model name='forklift_mast'><static>true</static><pose>13.9 2.55 1.0 0 0 -0.4</pose><link name='link'><collision name='c'><geometry><box><size>0.1 0.7 2.0</size></box></geometry></collision><visual name='v'><geometry><box><size>0.1 0.7 2.0</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual></link></model>
    <model name='forklift_fork_l'><static>true</static><pose>14.4 2.75 0.06 0 0 -0.4</pose><link name='link'><collision name='c'><geometry><box><size>0.9 0.1 0.06</size></box></geometry></collision><visual name='v'><geometry><box><size>0.9 0.1 0.06</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name='forklift_fork_r'><static>true</static><pose>14.4 2.35 0.06 0 0 -0.4</pose><link name='link'><collision name='c'><geometry><box><size>0.9 0.1 0.06</size></box></geometry></collision><visual name='v'><geometry><box><size>0.9 0.1 0.06</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>

    <!-- Pallet jack + trash bins -->
    <model name='pallet_jack_body'><static>true</static><pose>16.0 -1.0 0.075 0 0 0.2</pose><link name='link'><collision name='c'><geometry><box><size>1.0 0.5 0.15</size></box></geometry></collision><visual name='v'><geometry><box><size>1.0 0.5 0.15</size></box></geometry><material><ambient>0.85 0.15 0.1 1</ambient><diffuse>0.85 0.15 0.1 1</diffuse></material></visual></link></model>
    <model name='pallet_jack_handle'><static>true</static><pose>16.55 -1.25 0.45 -0.3 0 0.2</pose><link name='link'><collision name='c'><geometry><box><size>0.06 0.06 0.9</size></box></geometry></collision><visual name='v'><geometry><box><size>0.06 0.06 0.9</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name='trash_bin_1'><static>true</static><pose>13.0 -2.0 0.3 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry><material><ambient>0.15 0.4 0.2 1</ambient><diffuse>0.15 0.4 0.2 1</diffuse></material></visual></link></model>
    <model name='trash_bin_2'><static>true</static><pose>16.0 3.2 0.3 0 0 0</pose><link name='link'><collision name='c'><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision><visual name='v'><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry><material><ambient>0.15 0.4 0.2 1</ambient><diffuse>0.15 0.4 0.2 1</diffuse></material></visual></link></model>

    <!-- Overview camera (generic placement — see hospital.world's
         world_monitor_cam for the hand-tuned original). -->
    <model name='world_monitor_cam'>
      <static>true</static>
      <pose>7.5 7.0 5.3 0 0.55 -2.356</pose>
      <link name='link'>
        <sensor name='monitor_camera' type='camera'>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>world_monitor/image_raw</topic>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>35.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
