<?xml version="1.0" ?>
<!--
  Outdoor world with a real heightmap terrain (Fuel-hosted "Heightmap Bowl"
  by chapulina, auto-downloaded and cached by gz-sim at runtime).

  KNOWN RISK: Ogre2's heightmap-terrain shader has been observed to fail to
  compile alongside a GPU-based sensor (camera, gpu_lidar) under this kind
  of headless/software-EGL rendering fallback. If Gazebo crashes or the
  terrain fails to render on launch, fall back to a primitive-based outdoor
  world (ground plane + simple prop shapes) instead of a real heightmap.
-->
<sdf version="1.6">
  <world name="outdoor">

    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-navsat-system"
            name="ignition::gazebo::systems::NavSat"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.3977</latitude_deg>
      <longitude_deg>8.5456</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/chapulina/models/Heightmap Bowl
      </uri>
    </include>

    <!-- Light arena: 12x12 m, 40 posts r=0.45 every 1.3 m (0.4 m gaps) + features -->
    <model name='post_0'><static>true</static><pose>34.00 6.00 8.60 0 0 0</pose>
      <link name='link'><collision name='c'><geometry><cylinder><radius>0.45</radius><length>1.3</length></cylinder></geometry></collision>
        <visual name='v'><geometry><cylinder><radius>0.45</radius><length>1.3</length></cylinder></geometry><material><ambient>0.9 0.6 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name='post_1'><static>true</static><pose>52.00 -6.00 8.60 0 0 0</pose>
      <link name='link'><collision name='c'><geometry><cylinder><radius>0.45</radius><length>1.3</length></cylinder></geometry></collision>
