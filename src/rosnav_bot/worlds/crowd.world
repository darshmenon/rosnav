<?xml version="1.0" ?>
<!--
  crowd.world — enclosed lobby with furniture and six walking people.

  People are kinematic models with the standing MakeHuman mesh
  (model://person_standing) and a body-sized box collision. gpu_lidar hits
  visuals, and gz actors are not in that scene, so a plain actor would be
  invisible to the scan. Gravity off, friction off.

  They do not move by themselves. In another terminal, same GZ_PARTITION,
  run moving_obstacles_gz.py with its world argument set to crowd.

  Launch:
    ros2 launch rosnav_bot slam_nav.launch.py world_name:=crowd
-->
<sdf version='1.8'>
  <world name='crowd'>

    <physics name='4ms' type='ignored'>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.4 0.2 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
    </light>
    <light name='interior' type='point'>
      <pose>0 0 3.2 0 0 0</pose>
      <diffuse>0.9 0.88 0.8 1</diffuse>
      <attenuation><range>18</range><linear>0.04</linear></attenuation>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.62 0.60 0.56 1</ambient><diffuse>0.62 0.60 0.56 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 18.4 m x 12.4 m interior. Walls sit just outside that box. -->
    <model name='wall_n'><static>true</static><pose>0 6.3 1 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>18.8 0.2 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>18.8 0.2 2</size></box></geometry>
        <material><ambient>0.45 0.48 0.55 1</ambient><diffuse>0.45 0.48 0.55 1</diffuse></material></visual>
    </link></model>
    <model name='wall_s'><static>true</static><pose>0 -6.3 1 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>18.8 0.2 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>18.8 0.2 2</size></box></geometry>
        <material><ambient>0.45 0.48 0.55 1</ambient><diffuse>0.45 0.48 0.55 1</diffuse></material></visual>
    </link></model>
    <model name='wall_e'><static>true</static><pose>9.3 0 1 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.2 12.8 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.2 12.8 2</size></box></geometry>
        <material><ambient>0.45 0.48 0.55 1</ambient><diffuse>0.45 0.48 0.55 1</diffuse></material></visual>
    </link></model>
    <model name='wall_w'><static>true</static><pose>-9.3 0 1 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.2 12.8 2</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.2 12.8 2</size></box></geometry>
        <material><ambient>0.45 0.48 0.55 1</ambient><diffuse>0.45 0.48 0.55 1</diffuse></material></visual>
    </link></model>

    <!-- West seating. Chairs only on the outer sides so the gap between the
         two rows (y about 2.6 to 3.8) stays a walking aisle. -->
    <model name='table_a'><static>true</static><pose>-6.2 2.2 0.38 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>1.2 0.7 0.76</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.2 0.7 0.76</size></box></geometry>
        <material><ambient>0.45 0.28 0.14 1</ambient><diffuse>0.45 0.28 0.14 1</diffuse></material></visual>
    </link></model>
    <model name='table_b'><static>true</static><pose>-6.2 4.2 0.38 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>1.2 0.7 0.76</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.2 0.7 0.76</size></box></geometry>
        <material><ambient>0.45 0.28 0.14 1</ambient><diffuse>0.45 0.28 0.14 1</diffuse></material></visual>
    </link></model>
    <model name='table_c'><static>true</static><pose>-3.4 2.2 0.38 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>1.2 0.7 0.76</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.2 0.7 0.76</size></box></geometry>
        <material><ambient>0.45 0.28 0.14 1</ambient><diffuse>0.45 0.28 0.14 1</diffuse></material></visual>
    </link></model>
    <model name='table_d'><static>true</static><pose>-3.4 4.2 0.38 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>1.2 0.7 0.76</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.2 0.7 0.76</size></box></geometry>
        <material><ambient>0.45 0.28 0.14 1</ambient><diffuse>0.45 0.28 0.14 1</diffuse></material></visual>
    </link></model>
    <model name='chair_a'><static>true</static><pose>-6.2 1.55 0.28 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.4 0.4 0.56</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.4 0.4 0.56</size></box></geometry>
        <material><ambient>0.2 0.25 0.35 1</ambient><diffuse>0.2 0.25 0.35 1</diffuse></material></visual>
    </link></model>
    <model name='chair_b'><static>true</static><pose>-6.2 4.85 0.28 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.4 0.4 0.56</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.4 0.4 0.56</size></box></geometry>
        <material><ambient>0.2 0.25 0.35 1</ambient><diffuse>0.2 0.25 0.35 1</diffuse></material></visual>
    </link></model>
    <model name='chair_c'><static>true</static><pose>-3.4 1.55 0.28 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.4 0.4 0.56</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.4 0.4 0.56</size></box></geometry>
        <material><ambient>0.2 0.25 0.35 1</ambient><diffuse>0.2 0.25 0.35 1</diffuse></material></visual>
    </link></model>
    <model name='chair_d'><static>true</static><pose>-3.4 4.85 0.28 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.4 0.4 0.56</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.4 0.4 0.56</size></box></geometry>
        <material><ambient>0.2 0.25 0.35 1</ambient><diffuse>0.2 0.25 0.35 1</diffuse></material></visual>
    </link></model>

    <!-- North counter, east shelves, pillars, crates. Aisles stay open:
         y=0 (center), y=-5.2 (south), x=7.2 (east), x=-8.3 (west),
         y=3.2 between the tables, and a loop in the open east bay. -->
    <model name='counter'><static>true</static><pose>3.5 5.4 0.52 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>7.0 0.6 1.05</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>7.0 0.6 1.05</size></box></geometry>
        <material><ambient>0.55 0.52 0.48 1</ambient><diffuse>0.55 0.52 0.48 1</diffuse></material></visual>
    </link></model>
    <model name='shelf'><static>true</static><pose>8.4 -1.0 0.9 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.45 6.0 1.8</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.45 6.0 1.8</size></box></geometry>
        <material><ambient>0.35 0.32 0.28 1</ambient><diffuse>0.35 0.32 0.28 1</diffuse></material></visual>
    </link></model>
    <model name='pillar_1'><static>true</static><pose>0.2 3.0 1.0 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.45 0.45 2.0</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.45 0.45 2.0</size></box></geometry>
        <material><ambient>0.7 0.7 0.68 1</ambient><diffuse>0.7 0.7 0.68 1</diffuse></material></visual>
    </link></model>
    <model name='pillar_2'><static>true</static><pose>4.5 -1.5 1.0 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.4 0.4 2.0</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.4 0.4 2.0</size></box></geometry>
        <material><ambient>0.7 0.7 0.68 1</ambient><diffuse>0.7 0.7 0.68 1</diffuse></material></visual>
    </link></model>
    <model name='bench'><static>true</static><pose>-1.0 -2.5 0.25 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>1.6 0.45 0.5</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.6 0.45 0.5</size></box></geometry>
        <material><ambient>0.4 0.25 0.15 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material></visual>
    </link></model>
    <model name='bin'><static>true</static><pose>3.5 -2.8 0.35 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.5 0.5 0.7</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.5 0.5 0.7</size></box></geometry>
        <material><ambient>0.15 0.35 0.2 1</ambient><diffuse>0.15 0.35 0.2 1</diffuse></material></visual>
    </link></model>
    <model name='plant'><static>true</static><pose>-1.5 1.15 0.45 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.35 0.35 0.9</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.35 0.35 0.9</size></box></geometry>
        <material><ambient>0.15 0.4 0.18 1</ambient><diffuse>0.15 0.4 0.18 1</diffuse></material></visual>
    </link></model>
    <model name='divider'><static>true</static><pose>2.0 2.8 0.65 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.12 2.0 1.3</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.12 2.0 1.3</size></box></geometry>
        <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
    </link></model>
    <model name='sofa'><static>true</static><pose>5.2 -3.0 0.35 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>1.6 0.7 0.7</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.6 0.7 0.7</size></box></geometry>
        <material><ambient>0.35 0.2 0.22 1</ambient><diffuse>0.35 0.2 0.22 1</diffuse></material></visual>
    </link></model>
    <model name='side_table'><static>true</static><pose>1.2 -1.8 0.3 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.7 0.7 0.6</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.7 0.7 0.6</size></box></geometry>
        <material><ambient>0.5 0.4 0.28 1</ambient><diffuse>0.5 0.4 0.28 1</diffuse></material></visual>
    </link></model>
    <model name='crate'><static>true</static><pose>4.7 2.9 0.3 0 0 0</pose><link name='l'>
      <collision name='c'><geometry><box><size>0.55 0.55 0.6</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.55 0.55 0.6</size></box></geometry>
        <material><ambient>0.6 0.45 0.2 1</ambient><diffuse>0.6 0.45 0.2 1</diffuse></material></visual>
    </link></model>

    <!-- People. Pose z=0 puts the feet on the floor. Shirt colour is the torso. -->
    <model name='person_1'>
      <pose>-7.0 -5.2 0 0 0 0</pose>
      <link name='link'>
        <gravity>false</gravity>
        <inertial><mass>60</mass><inertia><ixx>8</ixx><iyy>8</iyy><izz>1</izz></inertia></inertial>
        <collision name='body'><pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.40 0.26 1.70</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name='body'>
          <pose>0 0 0.02 0.04 0 0</pose>
          <geometry><mesh><uri>model://person_standing/meshes/standing.dae</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name='person_2'>
      <pose>-8.0 0 0 0 0 0</pose>
      <link name='link'>
        <gravity>false</gravity>
        <inertial><mass>60</mass><inertia><ixx>8</ixx><iyy>8</iyy><izz>1</izz></inertia></inertial>
        <collision name='body'><pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.40 0.26 1.70</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name='body'>
          <pose>0 0 0.02 0.04 0 0</pose>
          <geometry><mesh><uri>model://person_standing/meshes/standing.dae</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name='person_3'>
      <pose>7.2 -5.2 0 0 0 1.5708</pose>
      <link name='link'>
        <gravity>false</gravity>
        <inertial><mass>60</mass><inertia><ixx>8</ixx><iyy>8</iyy><izz>1</izz></inertia></inertial>
        <collision name='body'><pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.40 0.26 1.70</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name='body'>
          <pose>0 0 0.02 0.04 0 0</pose>
          <geometry><mesh><uri>model://person_standing/meshes/standing.dae</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name='person_4'>
      <pose>-8.3 -4.0 0 0 0 1.5708</pose>
      <link name='link'>
        <gravity>false</gravity>
        <inertial><mass>60</mass><inertia><ixx>8</ixx><iyy>8</iyy><izz>1</izz></inertia></inertial>
        <collision name='body'><pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.40 0.26 1.70</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name='body'>
          <pose>0 0 0.02 0.04 0 0</pose>
          <geometry><mesh><uri>model://person_standing/meshes/standing.dae</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name='person_5'>
      <pose>-7.4 3.2 0 0 0 0</pose>
      <link name='link'>
        <gravity>false</gravity>
        <inertial><mass>60</mass><inertia><ixx>8</ixx><iyy>8</iyy><izz>1</izz></inertia></inertial>
        <collision name='body'><pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.40 0.26 1.70</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name='body'>
          <pose>0 0 0.02 0.04 0 0</pose>
          <geometry><mesh><uri>model://person_standing/meshes/standing.dae</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name='person_6'>
      <pose>3.2 1.6 0 0 0 0</pose>
      <link name='link'>
        <gravity>false</gravity>
        <inertial><mass>60</mass><inertia><ixx>8</ixx><iyy>8</iyy><izz>1</izz></inertia></inertial>
        <collision name='body'><pose>0 0 0.85 0 0 0</pose>
          <geometry><box><size>0.40 0.26 1.70</size></box></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name='body'>
          <pose>0 0 0.02 0.04 0 0</pose>
          <geometry><mesh><uri>model://person_standing/meshes/standing.dae</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name='world_monitor_cam'>
      <static>true</static>
      <pose>0 0 14 0 1.5708 0</pose>
      <link name='link'>
        <sensor name='monitor_camera' type='camera'>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>world_monitor/image_raw</topic>
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>30.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
