<?xml version="1.0"?>
<robot name="mecanum_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="robot_core_mecanum.xacro" />

    <xacro:include filename="gazebo_control_mecanum.xacro" />

    <xacro:include filename="lidar.xacro" />
    <xacro:include filename="imu.xacro" />

    <xacro:arg name="enable_camera" default="true"/>
    <xacro:arg name="enable_rgbd" default="false"/>
    <xacro:if value="${'$(arg enable_rgbd)' == 'true'}">
        <xacro:include filename="rgbd_camera.xacro" />
    </xacro:if>
    <xacro:unless value="${'$(arg enable_rgbd)' == 'true'}">
        <xacro:if value="${'$(arg enable_camera)' == 'true'}">
            <xacro:include filename="camera.xacro" />
        </xacro:if>
    </xacro:unless>

</robot>
