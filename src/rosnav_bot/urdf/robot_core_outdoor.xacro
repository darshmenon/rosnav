<?xml version="1.0"?>
<robot name="car_robot_outdoor" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gazebo="http://gazebo.apache.org/xmlns/gazebo">

  <!-- Outdoor variant of robot_core.xacro: wheel radius 0.16 m (indoor 0.075), SPHERE wheel collisions
       (cylinder-vs-heightmap barely moved), 8 kg chassis, axle->ground 0.16 m so ground clearance 0.16 m
       (indoor 0.075). Same link/joint names + axle origin as indoor so frames, sensors and Nav2 are unchanged. -->
  <xacro:include filename="inertial_macros.xacro" />

  <!-- Base Link -->
  <link name="base_link"/>
  <link name="base_footprint">
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.16"/>
  </joint>

  <!-- Chassis -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="-0.1 0 0"/>
  </joint>

  <link name="chassis">
    <visual>
      <origin xyz="0.275 0 0.05"/>
      <geometry><box size="0.55 0.4 0.10"/></geometry>
      <material name="skirt_material"><color rgba="0.16 0.16 0.18 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0.275 0 0.125"/>
      <geometry><box size="0.53 0.38 0.05"/></geometry>
      <material name="chassis_material"><color rgba="0.40 0.23 0.72 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0.25 0 0.151"/>
      <geometry><box size="0.40 0.30 0.004"/></geometry>
      <material name="accent_material"><color rgba="0.62 0.50 0.88 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0.56 0 0.04"/>
      <geometry><box size="0.02 0.4 0.05"/></geometry>
      <material name="bumper_material"><color rgba="0.08 0.08 0.09 1.0"/></material>
    </visual>
    <visual>
      <origin xyz="0.541 0 0.125"/>
      <geometry><box size="0.004 0.30 0.012"/></geometry>
      <material name="led_material"><color rgba="0.1 0.9 1.0 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.275 0 0.075"/>
      <geometry>
        <box size="0.55 0.34 0.15"/>
      </geometry>
    </collision>
      <xacro:inertial_box mass="8.0" x="0.55" y="0.4" z="0.15">
            <origin xyz="0.275 0 0.075" rpy="0 0 0"/>
         </xacro:inertial_box>
  </link>

  <!-- Rear Wheels -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.225 0" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.16" length="0.05"/>
      </geometry>
      <material name="wheel_material">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <visual>
      <geometry><cylinder radius="0.096" length="0.054"/></geometry>
      <material name="hub_material"><color rgba="0.70 0.70 0.74 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.16"/>
      </geometry>
    </collision>
        <xacro:inertial_cylinder mass="0.6" length="0.05" radius="0.16">
            <origin xyz="0 0 0" rpy="0 0 0"/>
         </xacro:inertial_cylinder>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.225 0" rpy="1.57 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.16" length="0.05"/>
      </geometry>
      <material name="wheel_material">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <visual>
      <geometry><cylinder radius="0.096" length="0.054"/></geometry>
      <material name="hub_material"><color rgba="0.70 0.70 0.74 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.16"/>
      </geometry>
    </collision>
        <xacro:inertial_cylinder mass="0.6" length="0.05" radius="0.16">
            <origin xyz="0 0 0" rpy="0 0 0"/>
         </xacro:inertial_cylinder>
  </link>

  <!-- Front Wheels -->
  <joint name="left_front_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="0.3 0.225 0" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.16" length="0.05"/>
      </geometry>
      <material name="wheel_material">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <visual>
      <geometry><cylinder radius="0.096" length="0.054"/></geometry>
      <material name="hub_material"><color rgba="0.70 0.70 0.74 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.16"/>
      </geometry>
    </collision>
        <xacro:inertial_cylinder mass="0.3" length="0.05" radius="0.16">
            <origin xyz="0 0 0" rpy="0 0 0"/>
         </xacro:inertial_cylinder>
  </link>

  <joint name="right_front_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="0.3 -0.225 0" rpy="1.57 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="right_front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.16" length="0.05"/>
      </geometry>
      <material name="wheel_material">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <visual>
      <geometry><cylinder radius="0.096" length="0.054"/></geometry>
      <material name="hub_material"><color rgba="0.70 0.70 0.74 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.16"/>
      </geometry>
    </collision>
        <xacro:inertial_cylinder mass="0.3" length="0.05" radius="0.16">
            <origin xyz="0 0 0" rpy="0 0 0"/>
         </xacro:inertial_cylinder>
  </link>

  <!-- Gazebo Parameters -->
  <gazebo reference="chassis">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="left_wheel">
    <mu1>1.2</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.2</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="left_front_wheel">
       <mu1>0.000001</mu1>
         <mu2>0.000001</mu2>
  </gazebo>

  <gazebo reference="right_front_wheel">
     <mu1>0.000001</mu1>
         <mu2>0.000001</mu2>
  </gazebo>

</robot>