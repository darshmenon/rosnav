<?xml version="1.0"?>
<robot name="car_robot" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gazebo="http://gazebo.apache.org/xmlns/gazebo">

  <xacro:include filename="inertial_macros.xacro" />

  <!-- Base Link -->
  <link name="base_link"/>
  <link name="base_footprint">
    <collision>
      <geometry>
        <box size="0.55 0.4 0.01"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <box size="0.55 0.4 0.01"/>
      </geometry>
      <material name="footprint_material">
        <color rgba="0.0 0.0 1.0 0.5"/>
      </material>
    </visual>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.05"/>
  </joint>

  <!-- Chassis — Husky A200 mesh skin (vendored from Clearpath husky_description,
       see meshes/husky/README.md), scaled 0.55x to fit this robot's existing
       0.55 x 0.4 x 0.15 footprint/wheelbase so nav2 footprint tuning,
       costmaps, and multi-robot spacing all stay valid unchanged. Collision
       geometry stays the original simple box — only the visual changed.
       Husky's own hull mesh sits with its origin at floor level, centered on
       x/y, so it is offset by the same (0.275, 0, 0) used for the collision
       box's bottom-center to line up. -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="-0.1 0 0"/>
  </joint>

  <link name="chassis">
    <visual>
      <origin xyz="0.275 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rosnav_bot/meshes/husky/visual/base_link.glb" scale="0.55 0.55 0.55"/>
      </geometry>
      <material name="chassis_material">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.275 0 0.075"/>
      <geometry>
        <box size="0.55 0.34 0.15"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.5" x="0.55" y="0.4" z="0.15">
      <origin xyz="0.275 0 0.075" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- Remaining Husky body panels (top cover, bumpers, top plate) — visual
       only, no collision/inertial of their own (already covered by the
       chassis box above). Joint origins are the source husky_description
       offsets scaled by the same 0.55 factor and shifted by the chassis
       mesh's (0.275, 0, 0) offset. -->
  <joint name="husky_top_chassis_joint" type="fixed">
    <parent link="chassis"/>
    <child link="husky_top_chassis"/>
    <origin xyz="0.275 0 0" rpy="0 0 0"/>
  </joint>
  <link name="husky_top_chassis">
    <visual>
      <geometry>
        <mesh filename="package://rosnav_bot/meshes/husky/visual/top_chassis.glb" scale="0.55 0.55 0.55"/>
      </geometry>
      <material name="chassis_top_material">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="husky_top_plate_joint" type="fixed">
    <parent link="chassis"/>
    <child link="husky_top_plate"/>
    <origin xyz="0.275 0 0" rpy="0 0 0"/>
  </joint>
  <link name="husky_top_plate">
    <visual>
      <geometry>
        <mesh filename="package://rosnav_bot/meshes/husky/visual/top_plate.glb" scale="0.55 0.55 0.55"/>
      </geometry>
      <material name="chassis_top_material">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="husky_front_bumper_joint" type="fixed">
    <parent link="chassis"/>
    <child link="husky_front_bumper"/>
    <origin xyz="0.539 0 0.05005" rpy="0 0 0"/>
  </joint>
  <link name="husky_front_bumper">
    <visual>
      <geometry>
        <mesh filename="package://rosnav_bot/meshes/husky/visual/bumper.glb" scale="0.55 0.55 0.55"/>
      </geometry>
      <material name="chassis_top_material">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="husky_rear_bumper_joint" type="fixed">
    <parent link="chassis"/>
    <child link="husky_rear_bumper"/>
    <origin xyz="0.011 0 0.05005" rpy="0 0 3.14159"/>
  </joint>
  <link name="husky_rear_bumper">
    <visual>
      <geometry>
        <mesh filename="package://rosnav_bot/meshes/husky/visual/bumper.glb" scale="0.55 0.55 0.55"/>
      </geometry>
      <material name="chassis_top_material">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Rear Wheels -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.225 0" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>
      <material name="wheel_material">
        <color rgba="0 0 0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>
    </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.075">
            <origin xyz="0 0 0" rpy="0 0 0"/>
         </xacro:inertial_cylinder>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.225 0" rpy="1.57 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>
      <material name="wheel_material">
        <color rgba="0 0 0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>
    </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.075">
            <origin xyz="0 0 0" rpy="0 0 0"/>
         </xacro:inertial_cylinder>
  </link>

  <!-- Front Wheels -->
  <joint name="left_front_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="0.3 0.225 0" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>
      <material name="wheel_material">
        <color rgba="0 0 0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>
    </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.075">
            <origin xyz="0 0 0" rpy="0 0 0"/>
         </xacro:inertial_cylinder>
  </link>

  <joint name="right_front_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="0.3 -0.225 0" rpy="1.57 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="right_front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>
      <material name="wheel_material">
        <color rgba="0 0 0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.075" length="0.04"/>
      </geometry>
    </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.075">
            <origin xyz="0 0 0" rpy="0 0 0"/>
         </xacro:inertial_cylinder>
  </link>

  <!-- Gazebo Parameters -->
  <gazebo reference="chassis">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="left_front_wheel">
       <mu1>0.000001</mu1>
         <mu2>0.000001</mu2>
  </gazebo>

  <gazebo reference="right_front_wheel">
     <mu1>0.000001</mu1>
         <mu2>0.000001</mu2>
  </gazebo>

</robot>
