<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- namespace arg: pass the robot namespace so TF frame IDs are unique per robot -->
  <xacro:arg name="namespace" default=""/>
  <xacro:property name="ns" value="$(arg namespace)"/>

   <gazebo>
      <plugin filename="libgz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
  <left_joint>left_wheel_joint</left_joint>
  <right_joint>right_wheel_joint</right_joint>


    <wheel_separation>0.35</wheel_separation>
    <wheel_radius>0.1</wheel_radius>

    <odom_publish_frequency>50</odom_publish_frequency>
    <topic>${ns + '/cmd_vel' if ns else 'cmd_vel'}</topic>


    <!-- PID controllers -->
    <wheel_acceleration>1.0</wheel_acceleration>
    <wheel_torque>10.0</wheel_torque>
    <max_linear_speed>2.0</max_linear_speed>
    <max_angular_speed>3.14</max_angular_speed>

    <odom_topic>${ns + '/odom' if ns else 'odom'}</odom_topic>
    <!-- frame IDs include namespace prefix so they are unique across robots -->
    <frame_id>${ns + '/odom' if ns else 'odom'}</frame_id>
    <child_frame_id>${ns + '/base_link' if ns else 'base_link'}</child_frame_id>
    <!-- NOT /tf: the DiffDrive plugin can't be told to skip TF publishing
         (no publish_odom_tf option in gz-sim8), so its odom->base_link
         transform is routed to an unbridged gz-transport topic instead of
         reaching ROS. ekf_filter_node (robot_localization) is the sole
         odom->base_link TF broadcaster on the ROS side — see config/ekf.yaml. -->
    <tf_topic>${ns + '/tf_wheel_raw' if ns else 'tf_wheel_raw'}</tf_topic>

    <!-- Add debug topics -->
    <debug>true</debug>
    <debug_topic>drive_debug</debug_topic>
  </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
         <topic>${ns + '/joint_states' if ns else 'joint_states'}</topic>
         <joint_name>right_wheel_joint</joint_name>
         <joint_name>left_wheel_joint</joint_name>

      </plugin>
   </gazebo>

</robot>
