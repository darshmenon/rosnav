Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Image
      Name: gs_capture_view
      Topic:
        Value: /gs_capture/image_raw
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: gs_splat_points
      Topic:
        Value: /gs_capture/splat_points
        Depth: 1
        Durability Policy: Transient Local
      Style: Flat Squares
      Size (Pixels): 4
      Color Transformer: RGB8
      Enabled: true
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
  Global Options:
    Fixed Frame: world
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
Window Geometry:
  Height: 720
  Width: 1000
  X: 50
  Y: 50
