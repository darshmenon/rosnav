Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Robot & TF1
    - /Navigation1
    - /SLAM & 3D1
    Splitter Ratio: 0.55
  Tree Height: 560
  Expanded:
  - /Global Options1
  - /Status1
  - /Robot & TF1
  - /Maps1
  - /Navigation1
  - /SLAM & 3D1
  - /Sensors1
  - /Cameras1
Visualization Manager:
  Displays:
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    Enabled: true
    Name: Robot & TF
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: gs_splat_points
      Topic:
        Value: /gs_capture/splat_points
        Depth: 1
        Durability Policy: Transient Local
      Style: Flat Squares
      Size (Pixels): 4
      Color Transformer: RGB8
      Enabled: true
    Enabled: true
    Name: SLAM & 3D
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/Image
      Name: gs_capture_view
      Topic:
        Value: /gs_capture/image_raw
      Enabled: true
    Enabled: true
    Name: Cameras
  Global Options:
    Fixed Frame: world
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
Window Geometry:
  Height: 720
  Width: 1000
  X: 50
  Y: 50
  Hide Right Dock: false
