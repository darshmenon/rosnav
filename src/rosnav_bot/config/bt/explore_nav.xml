<!--
  explore_nav.xml
  ═══════════════
  Nav2 Behavior Tree tuned for frontier exploration.

  Differences vs navigate_w_recovery:
    - Replans at 2 Hz (map grows while exploring; stale paths go bad fast)
    - Up to 4 outer recoveries (frontier goals are noisier than fixed waypoints)
    - Same RoundRobin recoveries: backup → spin → clear costmaps → wait

  Passed explicitly by frontier_explorer / frontier_coordinator via
  NavigateToPose.behavior_tree so exploration always gets this tree even
  if the navigator default BT is different.

  number_of_retries was 8 until 2026-08-25: a live warehouse.world run showed
  repeated failed BackUp/Spin cycles on one bad goal (each aborting early
  with "Pose Goes Off Grid" from behavior_server, i.e. jerky/incomplete
  motion) correlating with the SLAM map_odom yaw correction climbing
  continuously (146.1deg -> 166.1deg over ~15s) instead of settling -- a
  sign the repeated oscillating recovery motion was degrading scan-matching
  confidence. Fewer retries means a genuinely bad goal fails and gets
  blacklisted sooner, instead of grinding through more oscillation cycles
  that risk compounding localization drift. See EXPLORATION_TESTING_NOTES.md
  "Open bug: SLAM map_odom drift after repeated failed recovery".
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <RecoveryNode number_of_retries="4" name="ExploreNavigateRecovery">

      <PipelineSequence name="ExploreWithReplanning">

        <RateController hz="2.0">
          <RecoveryNode number_of_retries="1" name="ComputePathRecovery">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap
              name="ClearGlobalCostmap-Replanning"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <RecoveryNode number_of_retries="1" name="FollowPathRecovery">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap
            name="ClearLocalCostmap-Following"
            service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>

      </PipelineSequence>

      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <BackUp backup_dist="0.25" backup_speed="0.05"/>
          <Spin spin_dist="1.57"/>
          <Sequence name="ClearBothCostmaps">
            <ClearEntireCostmap
              name="ClearLocal"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap
              name="ClearGlobal"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Wait wait_duration="2"/>
        </RoundRobin>
      </ReactiveFallback>

    </RecoveryNode>
  </BehaviorTree>
</root>
