<?xml version="1.0"?>
<sdf version="1.6">
  <model name="rough_terrain">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><heightmap>
          <uri>model://rough_terrain/materials/textures/height.png</uri>
          <size>100.0 100.0 3.000</size><pos>0 0 0</pos>
        </heightmap></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><heightmap>
          <use_terrain_paging>false</use_terrain_paging>
          <texture><size>100.0</size>
            <diffuse>model://rough_terrain/materials/textures/diffuse.png</diffuse>
            <normal>model://rough_terrain/materials/textures/normal.png</normal></texture>
          <uri>model://rough_terrain/materials/textures/height.png</uri>
          <size>100.0 100.0 3.000</size><pos>0 0 0</pos>
        </heightmap></geometry>
      </visual>
    </link>
  </model>
</sdf>
