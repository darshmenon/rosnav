<?xml version='1.0'?>
<model>
  <name>dynamic_obstacle</name>
  <version>1.0</version>
  <sdf version='1.8'>model.sdf</sdf>

  <author>
    <name>rosnav_bot</name>
  </author>

  <description>
    Cylinder obstacle driven by the VelocityControl plugin. Spawned by
    slam_nav.launch.py / multi_robot.launch.py when dynamic_obstacles > 0
    and patrolled by scripts/dynamic_obstacle_driver.py over a ROS/Gazebo
    cmd_vel bridge, for testing Nav2 dynamic-obstacle avoidance and
    obstacle_tracker.py.
  </description>
</model>
